# ─────────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────────
import os

configfile: "config/config.yaml"

SAMPLES   = config["samples"]
RUN_ID    = config["run_id"]
FASTQ_DIR = config["fastq_dir"]
PAIRED    = config["sequencing"] == "paired"
NO_DB     = config.get("no_db", False)

print(f"DEBUG - run_id: {RUN_ID}  samples: {SAMPLES}  sequencing: {config['sequencing']}")


def get_r1(fastq_dir, sample):
    """Accept {sample}.fastq or {sample}_1.fastq for single-end data."""
    plain = f"{fastq_dir}/{sample}.fastq"
    return plain if os.path.exists(plain) else f"{fastq_dir}/{sample}_1.fastq"


def _se_stem_suffix():
    """Return the stem suffix FastQC will use: '' for plain .fastq, '_1' for _1.fastq."""
    if not SAMPLES:
        return "_1"
    plain = f"{FASTQ_DIR}/{SAMPLES[0]}.fastq"
    return "" if os.path.exists(plain) else "_1"


SE_STEM = _se_stem_suffix() if not PAIRED else "_1"


def fastqc_inputs(wildcards):
    files = [get_r1(FASTQ_DIR, wildcards.sample)]
    if PAIRED:
        files.append(f"{FASTQ_DIR}/{wildcards.sample}_2.fastq")
    return files


FASTQC_OUTPUTS = (
    [
        "results/" + RUN_ID + "/fastqc/{sample}_1_fastqc.html",
        "results/" + RUN_ID + "/fastqc/{sample}_2_fastqc.html",
    ]
    if PAIRED else
    [f"results/{RUN_ID}/fastqc/{{sample}}{SE_STEM}_fastqc.html"]
)


def star_reads(wildcards):
    r1 = get_r1(FASTQ_DIR, wildcards.sample)
    if PAIRED:
        r2 = f"{FASTQ_DIR}/{wildcards.sample}_2.fastq"
        return f"{r1} {r2}"
    return r1

# ─────────────────────────────────────────────
# Rule all — defines the final targets
# Snakemake works backwards from these to figure
# out every step that needs to run
# ─────────────────────────────────────────────
rule all:
    input:
        config["common_snps_vcf"],
        config["common_snps_vcf"] + ".tbi",
        expand("results/{run}/fastqc/{sample}" + SE_STEM + "_fastqc.html", run=RUN_ID, sample=SAMPLES),
        expand("results/{run}/fastqc/{sample}_2_fastqc.html", run=RUN_ID, sample=SAMPLES) if PAIRED else [],
        expand("results/{run}/bam/{sample}.sorted.bam.bai",   run=RUN_ID, sample=SAMPLES),
        expand("results/{run}/bam/{sample}.flagstat.txt",     run=RUN_ID, sample=SAMPLES),
        expand("results/{run}/vcf/{sample}.genotyped.vcf",    run=RUN_ID, sample=SAMPLES),
        [] if NO_DB else expand("results/{run}/db/{sample}.loaded", run=RUN_ID, sample=SAMPLES)


# ─────────────────────────────────────────────
# normalize_snp_panel — run once to produce the
# chr-prefixed, bgzipped, tabix-indexed common
# SNP panel used as target positions for pileup.
# Re-runs only if the source VCF changes.
# ─────────────────────────────────────────────
rule normalize_snp_panel:
    input:
        vcf      = config["common_snps_source"],
        conv     = "workflow/chr_name_conv.txt"
    output:
        vcf      = config["common_snps_vcf"],
        tbi      = config["common_snps_vcf"] + ".tbi"
    log:
        "logs/normalize_snp_panel.log"
    shell:
        """
        mkdir -p $(dirname {output.vcf})
        bcftools annotate \
            --rename-chrs {input.conv} \
            --output-type z \
            -o {output.vcf} \
            {input.vcf} \
            2> {log}
        tabix -p vcf {output.vcf} 2>> {log}
        """


# ─────────────────────────────────────────────
# FastQC — quality check on raw reads
# ─────────────────────────────────────────────
rule fastqc:
    input:
        fastqc_inputs
    output:
        FASTQC_OUTPUTS
    log:
        "logs/" + RUN_ID + "/fastqc/{sample}.log"
    shell:
        "fastqc {input} --outdir results/" + RUN_ID + "/fastqc/ 2> {log}"


# ─────────────────────────────────────────────
# STAR index — run once, not per sample
# ─────────────────────────────────────────────
rule star_index:
    input:
        fasta = config["reference_genome"],
        gtf   = config["annotation_gtf"]
    output:
        directory(config["star_index_dir"])
    threads:
        config["star"]["threads"]
    log:
        "logs/star_index.log"
    shell:
        """
        mkdir -p {output}
        STAR --runMode genomeGenerate \
             --genomeDir {output} \
             --genomeFastaFiles {input.fasta} \
             --sjdbGTFfile {input.gtf} \
             --sjdbOverhang {config[sjdb_overhang]} \
             --genomeSAindexNbases {config[genome_sa_index_nbases]} \
             --runThreadN {threads} \
             2> {log}
        """


# ─────────────────────────────────────────────
# STAR align — one job per sample
# ─────────────────────────────────────────────
rule star_align:
    input:
        reads = star_reads,
        index = config["star_index_dir"]
    output:
        bam     = "results/" + RUN_ID + "/star/{sample}/Aligned.out.bam",
        star_log = "results/" + RUN_ID + "/star/{sample}/Log.final.out"
    threads:
        config["star"]["threads"]
    log:
        "logs/" + RUN_ID + "/star/{sample}.log"
    params:
        prefix = "results/" + RUN_ID + "/star/{sample}/"
    shell:
        """
        STAR --runThreadN {threads} \
             --genomeDir {input.index} \
             --readFilesIn {input.reads} \
             --outSAMtype BAM Unsorted \
             --outSAMattributes NH HI AS NM MD \
             --outFileNamePrefix {params.prefix} \
             2> {log}
        """


# ─────────────────────────────────────────────
# Samtools sort
# ─────────────────────────────────────────────
rule samtools_sort:
    input:
        "results/" + RUN_ID + "/star/{sample}/Aligned.out.bam"
    output:
        "results/" + RUN_ID + "/bam/{sample}.sorted.bam"
    threads:
        config["samtools"]["threads"]
    log:
        "logs/" + RUN_ID + "/samtools_sort/{sample}.log"
    shell:
        "samtools sort -@ {threads} -o {output} {input} 2> {log}"


# ─────────────────────────────────────────────
# Samtools index
# ─────────────────────────────────────────────
rule samtools_index:
    input:
        "results/" + RUN_ID + "/bam/{sample}.sorted.bam"
    output:
        "results/" + RUN_ID + "/bam/{sample}.sorted.bam.bai"
    log:
        "logs/" + RUN_ID + "/samtools_index/{sample}.log"
    shell:
        "samtools index {input} 2> {log}"


# ─────────────────────────────────────────────
# Samtools flagstat — QC mapping rate check
# Fails loudly if mapping rate is below threshold
# ─────────────────────────────────────────────
rule samtools_flagstat:
    input:
        "results/" + RUN_ID + "/bam/{sample}.sorted.bam"
    output:
        "results/" + RUN_ID + "/bam/{sample}.flagstat.txt"
    log:
        "logs/" + RUN_ID + "/samtools_flagstat/{sample}.log"
    params:
        min_rate = config["samtools"]["min_mapping_rate"]
    shell:
        """
        samtools flagstat {input} > {output} 2> {log}

        mapping_rate=$(grep "mapped (" {output} \
            | head -1 \
            | grep -oP '[0-9]+\\.[0-9]+(?=%)' \
            | head -1)

        echo "Mapping rate for {wildcards.sample}: ${{mapping_rate}}%"

        python3 -c "
rate = float('${{mapping_rate}}')
threshold = float('{params.min_rate}')
if rate < threshold:
    raise SystemExit(f'FAIL: mapping rate {{rate:.1f}}% is below threshold {{threshold}}%')
else:
    print(f'PASS: mapping rate {{rate:.1f}}%')
"
        """


# ─────────────────────────────────────────────
# bcftools mpileup — pileup reads at common SNP
# positions only (-T restricts to target sites).
# --annotate AD adds allelic depth per position
# so we can store ref/alt counts for all GTs.
# ─────────────────────────────────────────────
rule bcftools_mpileup:
    input:
        bam    = "results/" + RUN_ID + "/bam/{sample}.sorted.bam",
        bai    = "results/" + RUN_ID + "/bam/{sample}.sorted.bam.bai",
        ref    = config["reference_genome"],
        snps   = config["common_snps_vcf"],
        snps_i = config["common_snps_vcf"] + ".tbi"
    output:
        "results/" + RUN_ID + "/vcf/{sample}.mpileup.bcf"
    log:
        "logs/" + RUN_ID + "/bcftools_mpileup/{sample}.log"
    params:
        min_bq = config["bcftools"]["min_base_quality"],
        min_mq = config["bcftools"]["min_mapping_quality"]
    shell:
        """
        bcftools mpileup \
            -f {input.ref} \
            -T {input.snps} \
            -q {params.min_mq} \
            -Q {params.min_bq} \
            --annotate AD \
            --output-type b \
            -o {output} \
            {input.bam} \
            2> {log}
        """


# ─────────────────────────────────────────────
# bcftools call — genotype all target positions.
# --variants-only is intentionally omitted so
# that 0/0 (ref/ref) calls are also emitted —
# these are informative for donor matching when
# coverage is sparse.
# ─────────────────────────────────────────────
rule bcftools_call:
    input:
        "results/" + RUN_ID + "/vcf/{sample}.mpileup.bcf"
    output:
        "results/" + RUN_ID + "/vcf/{sample}.raw.vcf"
    log:
        "logs/" + RUN_ID + "/bcftools_call/{sample}.log"
    params:
        caller = config["bcftools"]["caller"]
    shell:
        """
        bcftools call \
            {params.caller} \
            --output-type v \
            -o {output} \
            {input} \
            2> {log}
        """


# ─────────────────────────────────────────────
# bcftools filter — apply quality thresholds.
# QUAL < min_qual is only applied to ALT calls
# (GT != "0/0") because ref/ref positions have
# QUAL ~ 0 by design and would otherwise all be
# dropped. DP < min_depth drops all positions
# regardless of genotype.
# ─────────────────────────────────────────────
rule bcftools_filter:
    input:
        "results/" + RUN_ID + "/vcf/{sample}.raw.vcf"
    output:
        "results/" + RUN_ID + "/vcf/{sample}.genotyped.vcf"
    log:
        "logs/" + RUN_ID + "/bcftools_filter/{sample}.log"
    params:
        min_qual  = config["filters"]["min_qual"],
        min_depth = config["filters"]["min_depth"]
    shell:
        """
        bcftools filter \
            -e 'DP < {params.min_depth} || (GT!="0/0" && QUAL < {params.min_qual})' \
            -o {output} \
            {input} \
            2> {log}
        """


# ─────────────────────────────────────────────
# Load to database — push variant counts and QC
# metrics to Grist and full variant rows to SQLite
# ─────────────────────────────────────────────
rule load_to_database:
    input:
        vcf      = "results/" + RUN_ID + "/vcf/{sample}.genotyped.vcf",
        flagstat = "results/" + RUN_ID + "/bam/{sample}.flagstat.txt",
        star_log = "results/" + RUN_ID + "/star/{sample}/Log.final.out"
    output:
        touch("results/" + RUN_ID + "/db/{sample}.loaded")
    log:
        "logs/" + RUN_ID + "/load_to_database/{sample}.log"
    params:
        run_id     = RUN_ID,
        db         = config["db_path"],
        reference  = config["reference_genome"],
        sequencing = config["sequencing"]
    shell:
        """
        python scripts/load_to_db.py \
            --run-id     {params.run_id} \
            --sample     {wildcards.sample} \
            --vcf        {input.vcf} \
            --flagstat   {input.flagstat} \
            --star-log   {input.star_log} \
            --db         {params.db} \
            --reference  {params.reference} \
            --sequencing {params.sequencing} \
            2> {log}
        """