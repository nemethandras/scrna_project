# ─────────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────────
import os

configfile: "config/config.yaml"

SAMPLES   = config["samples"]
RUN_ID    = config["run_id"]
FASTQ_DIR = config["fastq_dir"]
PAIRED    = config["sequencing"] == "paired"
NO_DB     = config.get("no_db", False)

print(f"DEBUG - run_id: {RUN_ID}  samples: {SAMPLES}  sequencing: {config['sequencing']}")


def get_r1(fastq_dir, sample):
    """Accept {sample}.fastq or {sample}_1.fastq for single-end data."""
    plain = f"{fastq_dir}/{sample}.fastq"
    return plain if os.path.exists(plain) else f"{fastq_dir}/{sample}_1.fastq"


def _se_stem_suffix():
    """Return the stem suffix FastQC will use: '' for plain .fastq, '_1' for _1.fastq."""
    if not SAMPLES:
        return "_1"
    plain = f"{FASTQ_DIR}/{SAMPLES[0]}.fastq"
    return "" if os.path.exists(plain) else "_1"


SE_STEM = _se_stem_suffix() if not PAIRED else "_1"


def fastqc_inputs(wildcards):
    files = [get_r1(FASTQ_DIR, wildcards.sample)]
    if PAIRED:
        files.append(f"{FASTQ_DIR}/{wildcards.sample}_2.fastq")
    return files


FASTQC_OUTPUTS = (
    [
        "results/" + RUN_ID + "/fastqc/{sample}_1_fastqc.html",
        "results/" + RUN_ID + "/fastqc/{sample}_2_fastqc.html",
    ]
    if PAIRED else
    [f"results/{RUN_ID}/fastqc/{{sample}}{SE_STEM}_fastqc.html"]
)


def star_reads(wildcards):
    r1 = get_r1(FASTQ_DIR, wildcards.sample)
    if PAIRED:
        r2 = f"{FASTQ_DIR}/{wildcards.sample}_2.fastq"
        return f"{r1} {r2}"
    return r1

# ─────────────────────────────────────────────
# Rule all — defines the final targets
# Snakemake works backwards from these to figure
# out every step that needs to run
# ─────────────────────────────────────────────
rule all:
    input:
        config["common_snps_vcf"],
        config["common_snps_vcf"] + ".tbi",
        expand("results/{run}/fastqc/{sample}" + SE_STEM + "_fastqc.html", run=RUN_ID, sample=SAMPLES),
        expand("results/{run}/fastqc/{sample}_2_fastqc.html", run=RUN_ID, sample=SAMPLES) if PAIRED else [],
        expand("results/{run}/bam/{sample}.sorted.bam.bai",   run=RUN_ID, sample=SAMPLES),
        expand("results/{run}/bam/{sample}.flagstat.txt",     run=RUN_ID, sample=SAMPLES),
        expand("results/{run}/vcf/{sample}.genotyped.vcf",    run=RUN_ID, sample=SAMPLES),
        [] if NO_DB else expand("results/{run}/db/{sample}.loaded", run=RUN_ID, sample=SAMPLES)


# ─────────────────────────────────────────────
# normalize_snp_panel — run once to produce the
# chr-prefixed, bgzipped, tabix-indexed common
# SNP panel used as target positions for pileup.
# Re-runs only if the source VCF changes.
# ─────────────────────────────────────────────
rule normalize_snp_panel:
    input:
        vcf      = config["common_snps_source"],
        conv     = "workflow/chr_name_conv.txt"
    output:
        vcf      = config["common_snps_vcf"],
        tbi      = config["common_snps_vcf"] + ".tbi"
    log:
        "logs/normalize_snp_panel.log"
    shell:
        """
        mkdir -p $(dirname {output.vcf})
        bcftools annotate \
            --rename-chrs {input.conv} \
            {input.vcf} \
            2> {log} \
        | bcftools sort \
            --output-type z \
            -o {output.vcf} \
            2>> {log}
        tabix -p vcf {output.vcf} 2>> {log}
        """


# ─────────────────────────────────────────────
# FastQC — quality check on raw reads
# ─────────────────────────────────────────────
rule fastqc:
    input:
        fastqc_inputs
    output:
        FASTQC_OUTPUTS
    log:
        "logs/" + RUN_ID + "/fastqc/{sample}.log"
    shell:
        "fastqc {input} --outdir results/" + RUN_ID + "/fastqc/ 2> {log}"


# ─────────────────────────────────────────────
# STAR index — run once, not per sample
# ─────────────────────────────────────────────
rule star_index:
    input:
        fasta = config["reference_genome"],
        gtf   = config["annotation_gtf"]
    output:
        directory(config["star_index_dir"])
    threads:
        config["star"]["threads"]
    log:
        "logs/star_index.log"
    shell:
        """
        mkdir -p {output}
        STAR --runMode genomeGenerate \
             --genomeDir {output} \
             --genomeFastaFiles {input.fasta} \
             --sjdbGTFfile {input.gtf} \
             --sjdbOverhang {config[sjdb_overhang]} \
             --genomeSAindexNbases {config[genome_sa_index_nbases]} \
             --runThreadN {threads} \
             2> {log}
        """


# ─────────────────────────────────────────────
# STAR align — one job per sample
# ─────────────────────────────────────────────
rule star_align:
    input:
        reads = star_reads,
        index = config["star_index_dir"]
    output:
        bam     = "results/" + RUN_ID + "/star/{sample}/Aligned.out.bam",
        star_log = "results/" + RUN_ID + "/star/{sample}/Log.final.out"
    threads:
        config["star"]["threads"]
    log:
        "logs/" + RUN_ID + "/star/{sample}.log"
    params:
        prefix = "results/" + RUN_ID + "/star/{sample}/"
    shell:
        """
        STAR --runThreadN {threads} \
             --genomeDir {input.index} \
             --readFilesIn {input.reads} \
             --outSAMtype BAM Unsorted \
             --outSAMattributes NH HI AS NM MD \
             --outFileNamePrefix {params.prefix} \
             2> {log}
        """


# ─────────────────────────────────────────────
# Samtools sort
# ─────────────────────────────────────────────
rule samtools_sort:
    input:
        "results/" + RUN_ID + "/star/{sample}/Aligned.out.bam"
    output:
        "results/" + RUN_ID + "/bam/{sample}.sorted.bam"
    threads:
        config["samtools"]["threads"]
    log:
        "logs/" + RUN_ID + "/samtools_sort/{sample}.log"
    shell:
        "samtools sort -@ {threads} -o {output} {input} 2> {log}"


# ─────────────────────────────────────────────
# Samtools index
# ─────────────────────────────────────────────
rule samtools_index:
    input:
        "results/" + RUN_ID + "/bam/{sample}.sorted.bam"
    output:
        "results/" + RUN_ID + "/bam/{sample}.sorted.bam.bai"
    log:
        "logs/" + RUN_ID + "/samtools_index/{sample}.log"
    shell:
        "samtools index {input} 2> {log}"


# ─────────────────────────────────────────────
# Samtools flagstat — QC mapping rate check
# Fails loudly if mapping rate is below threshold
# ─────────────────────────────────────────────
rule samtools_flagstat:
    input:
        "results/" + RUN_ID + "/bam/{sample}.sorted.bam"
    output:
        "results/" + RUN_ID + "/bam/{sample}.flagstat.txt"
    log:
        "logs/" + RUN_ID + "/samtools_flagstat/{sample}.log"
    params:
        min_rate = config["samtools"]["min_mapping_rate"]
    shell:
        """
        samtools flagstat {input} > {output} 2> {log}

        mapping_rate=$(grep "mapped (" {output} \
            | head -1 \
            | grep -oP '[0-9]+\\.[0-9]+(?=%)' \
            | head -1)

        echo "Mapping rate for {wildcards.sample}: ${{mapping_rate}}%"

        python3 -c "
rate = float('${{mapping_rate}}')
threshold = float('{params.min_rate}')
if rate < threshold:
    raise SystemExit(f'FAIL: mapping rate {{rate:.1f}}% is below threshold {{threshold}}%')
else:
    print(f'PASS: mapping rate {{rate:.1f}}%')
"
        """


# ─────────────────────────────────────────────
# bcftools mpileup — pileup reads at common SNP
# positions only (-T restricts to target sites).
# --annotate AD adds allelic depth per position
# so we can store ref/alt counts for all GTs.
# ─────────────────────────────────────────────
rule bcftools_mpileup:
    input:
        bam    = "results/" + RUN_ID + "/bam/{sample}.sorted.bam",
        bai    = "results/" + RUN_ID + "/bam/{sample}.sorted.bam.bai",
        ref    = config["reference_genome"],
        snps   = config["common_snps_vcf"],
        snps_i = config["common_snps_vcf"] + ".tbi"
    output:
        "results/" + RUN_ID + "/vcf/{sample}.mpileup.bcf"
    log:
        "logs/" + RUN_ID + "/bcftools_mpileup/{sample}.log"
    params:
        min_bq = config["bcftools"]["min_base_quality"],
        min_mq = config["bcftools"]["min_mapping_quality"]
    shell:
        """
        bcftools mpileup \
            -f {input.ref} \
            -T {input.snps} \
            -q {params.min_mq} \
            -Q {params.min_bq} \
            --annotate AD \
            --output-type b \
            -o {output} \
            {input.bam} \
            2> {log}
        """


# ─────────────────────────────────────────────
# bcftools call — genotype all target positions.
# --variants-only is intentionally omitted so
# that 0/0 (ref/ref) calls are also emitted —
# these are informative for donor matching when
# coverage is sparse.
# ─────────────────────────────────────────────
rule bcftools_call:
    input:
        "results/" + RUN_ID + "/vcf/{sample}.mpileup.bcf"
    output:
        "results/" + RUN_ID + "/vcf/{sample}.raw.vcf"
    log:
        "logs/" + RUN_ID + "/bcftools_call/{sample}.log"
    params:
        caller = config["bcftools"]["caller"]
    shell:
        """
        bcftools call \
            {params.caller} \
            --output-type v \
            -o {output} \
            {input} \
            2> {log}
        """


# ─────────────────────────────────────────────
# bcftools filter — apply quality thresholds.
# QUAL < min_qual is only applied to ALT calls
# (GT != "0/0") because ref/ref positions have
# QUAL ~ 0 by design and would otherwise all be
# dropped. DP < min_depth drops all positions
# regardless of genotype.
# ─────────────────────────────────────────────
rule bcftools_filter:
    input:
        "results/" + RUN_ID + "/vcf/{sample}.raw.vcf"
    output:
        "results/" + RUN_ID + "/vcf/{sample}.genotyped.vcf"
    log:
        "logs/" + RUN_ID + "/bcftools_filter/{sample}.log"
    params:
        min_qual  = config["filters"]["min_qual"],
        min_depth = config["filters"]["min_depth"]
    shell:
        """
        bcftools filter \
            -e 'DP < {params.min_depth} || (GT!="0/0" && QUAL < {params.min_qual})' \
            -o {output} \
            {input} \
            2> {log}
        """


# ─────────────────────────────────────────────
# Load to database — push variant counts and QC
# metrics to Grist and full variant rows to SQLite
# ─────────────────────────────────────────────
rule load_to_database:
    input:
        vcf      = "results/" + RUN_ID + "/vcf/{sample}.genotyped.vcf",
        flagstat = "results/" + RUN_ID + "/bam/{sample}.flagstat.txt",
        star_log = "results/" + RUN_ID + "/star/{sample}/Log.final.out"
    output:
        touch("results/" + RUN_ID + "/db/{sample}.loaded")
    log:
        "logs/" + RUN_ID + "/load_to_database/{sample}.log"
    params:
        run_id     = RUN_ID,
        db         = config["db_path"],
        reference  = config["reference_genome"],
        sequencing = config["sequencing"],
        cell_line_flag = (
            f"--cell-line {config['cell_line']}"
            if config.get("cell_line") else ""
        )
    shell:
        """
        python scripts/load_to_db.py \
            --run-id     {params.run_id} \
            --sample     {wildcards.sample} \
            --vcf        {input.vcf} \
            --flagstat   {input.flagstat} \
            --star-log   {input.star_log} \
            --db         {params.db} \
            --reference  {params.reference} \
            --sequencing {params.sequencing} \
            {params.cell_line_flag} \
            2> {log}
        """


# ═════════════════════════════════════════════
# Demultiplexing — CellRanger BAM → cell line
# assignment against the genotype database.
#
# These rules are NOT part of rule all.
# Run explicitly:
#   snakemake results/demux/<demux_run_id>/assignments.tsv
#
# Configure the demux: section in config.yaml first.
# ═════════════════════════════════════════════

def _demux_cfg(key):
    """Retrieve a required demux config value, failing clearly if not set."""
    val = config.get("demux", {}).get(key)
    if val is None:
        raise ValueError(
            f"demux.{key} is not set in config.yaml — "
            f"fill in the demux: section before running demultiplexing."
        )
    return val


def _demux_cfg_opt(key):
    """Retrieve an optional demux config value; returns None if not set."""
    return config.get("demux", {}).get(key)


def _demux_bam():
    """Return the BAM path: explicit demux.bam, or constructed from cellranger_dir."""
    bam = _demux_cfg_opt("bam")
    if bam:
        return bam
    cdir = _demux_cfg_opt("cellranger_dir")
    if cdir:
        return os.path.join(cdir, "outs/possorted_genome_bam.bam")
    raise ValueError(
        "Set either demux.bam or demux.cellranger_dir in config.yaml."
    )


def _demux_barcodes():
    """Return the barcodes path: explicit demux.barcodes, or constructed from cellranger_dir."""
    bc = _demux_cfg_opt("barcodes")
    if bc:
        return bc
    cdir = _demux_cfg_opt("cellranger_dir")
    if cdir:
        return os.path.join(cdir, "outs/filtered_feature_bc_matrix/barcodes.tsv.gz")
    raise ValueError(
        "Set either demux.barcodes or demux.cellranger_dir in config.yaml."
    )


# ─────────────────────────────────────────────
# cellsnp_pileup — pileup the CellRanger BAM at
# common SNP positions, per cell barcode.
# Produces the per-cell AD/DP matrices used by
# the scorer.
# ─────────────────────────────────────────────
rule cellsnp_pileup:
    input:
        bam      = lambda _: _demux_bam(),
        barcodes = lambda _: _demux_barcodes(),
        snps    = config["common_snps_vcf"],
        snps_i  = config["common_snps_vcf"] + ".tbi"
    output:
        directory("results/demux/{demux_run_id}/cellsnp")
    threads:
        lambda _: config.get("demux", {}).get("threads", 8)
    log:
        "logs/demux/{demux_run_id}/cellsnp.log"
    shell:
        """
        mkdir -p {output}
        cellsnp-lite \
            -s {input.bam} \
            -b {input.barcodes} \
            -O {output} \
            -R {input.snps} \
            -p {threads} \
            --minMAF 0 \
            --minCOUNT 20 \
            --gzip \
            2> {log}
        """


# ─────────────────────────────────────────────
# demux_cells — score each cell barcode against
# all reference genotypes in the DB and assign
# it to the best-matching cell line.
# ─────────────────────────────────────────────
rule demux_cells:
    input:
        cellsnp = "results/demux/{demux_run_id}/cellsnp"
    output:
        "results/demux/{demux_run_id}/assignments.tsv"
    log:
        "logs/demux/{demux_run_id}/demux.log"
    params:
        db          = config["db_path"],
        run_ids     = lambda _: " ".join(_demux_cfg("run_ids")) or "all",
        min_depth   = lambda _: config.get("demux", {}).get("min_depth", 10),
        min_pos     = lambda _: config.get("demux", {}).get("min_positions", 50),
        gap         = lambda _: config.get("demux", {}).get("doublet_gap", 2.0),
        threshold   = lambda _: config.get("demux", {}).get("no_match_threshold", -0.5),
        demux_id    = "{demux_run_id}",
        load_db_flag = lambda _: "--load-db" if config.get("demux", {}).get("load_db") else ""
    shell:
        """
        python scripts/demux.py \
            --cellsnp-dir {input.cellsnp} \
            --db          {params.db} \
            --run-ids     {params.run_ids} \
            --output      {output} \
            --min-depth   {params.min_depth} \
            --min-positions {params.min_pos} \
            --doublet-gap {params.gap} \
            --no-match-threshold {params.threshold} \
            --demux-run-id {params.demux_id} \
            {params.load_db_flag} \
            2> {log}
        """


# ─────────────────────────────────────────────
# make_donor_vcf — build a multi-sample donor
# genotype VCF from DB references.  Only runs
# when demux.known_lines is set in config.yaml.
# Output is used by vireo_demux as -d input.
#
# Run explicitly:
#   snakemake results/demux/<demux_run_id>/donor_ref.vcf
# ─────────────────────────────────────────────
def _known_lines():
    return _demux_cfg_opt("known_lines") or []

def _donor_vcf_path(demux_run_id):
    explicit = _demux_cfg_opt("donor_vcf")
    return explicit if explicit else f"results/demux/{demux_run_id}/donor_ref.vcf"

rule make_donor_vcf:
    output:
        "results/demux/{demux_run_id}/donor_ref.vcf"
    log:
        "logs/demux/{demux_run_id}/make_donor_vcf.log"
    params:
        db          = config["db_path"],
        cell_lines  = lambda _: " ".join(_known_lines()),
        extra_flag  = lambda _: (
            f"--extra-vcf {_demux_cfg_opt('donor_vcf')}"
            if _demux_cfg_opt("donor_vcf") else ""
        )
    shell:
        """
        python scripts/make_donor_vcf.py \
            --cell-lines {params.cell_lines} \
            --db         {params.db} \
            {params.extra_flag} \
            --output     {output} \
            2> {log}
        """


# ─────────────────────────────────────────────
# vireo_demux — donor clustering.
# Genotype-free (default): clusters cells into
# anonymous donors and infers genotypes.
# Reference-guided (when demux.known_lines set):
# uses a donor genotype VCF as prior; assigns
# cells directly to named donors.
#
# Run explicitly:
#   snakemake results/demux/<demux_run_id>/vireo
# ─────────────────────────────────────────────
def _vireo_inputs(wildcards):
    inputs = {"cellsnp": f"results/demux/{wildcards.demux_run_id}/cellsnp"}
    if _known_lines() or _demux_cfg_opt("donor_vcf"):
        # Explicit donor_vcf path takes priority; otherwise use the generated one
        if not _demux_cfg_opt("donor_vcf"):
            inputs["donor_ref"] = f"results/demux/{wildcards.demux_run_id}/donor_ref.vcf"
    return inputs

rule vireo_demux:
    input:
        unpack(_vireo_inputs)
    output:
        directory("results/demux/{demux_run_id}/vireo")
    threads:
        lambda _: config.get("demux", {}).get("threads", 8)
    log:
        "logs/demux/{demux_run_id}/vireo.log"
    params:
        n_flag = lambda _: (
            f"-N {config['demux']['n_donors']}"
            if config.get("demux", {}).get("n_donors") and not _known_lines() else ""
        ),
        d_flag = lambda wildcards: (
            f"-d {_demux_cfg_opt('donor_vcf') or f'results/demux/{wildcards.demux_run_id}/donor_ref.vcf'}"
            if _known_lines() or _demux_cfg_opt("donor_vcf") else ""
        ),
        geno_tag = lambda _: "--genoTag GT" if (_known_lines() or _demux_cfg_opt("donor_vcf")) else ""
    shell:
        """
        mkdir -p {output}
        vireo \
            -c {input.cellsnp} \
            {params.n_flag} \
            {params.d_flag} \
            {params.geno_tag} \
            -o {output} \
            --randSeed 42 \
            2> {log}
        """


# ─────────────────────────────────────────────
# match_vireo_donors — match Vireo's inferred
# donor genotypes against DB references.
# Skipped in reference-guided mode (Vireo already
# knows the cell line identities).
#
# Run explicitly:
#   snakemake results/demux/<demux_run_id>/donor_matches.tsv
# ─────────────────────────────────────────────
rule match_vireo_donors:
    input:
        vireo = "results/demux/{demux_run_id}/vireo"
    output:
        "results/demux/{demux_run_id}/donor_matches.tsv"
    log:
        "logs/demux/{demux_run_id}/match_vireo.log"
    params:
        db      = config["db_path"],
        run_ids  = lambda _: " ".join(_demux_cfg_opt("run_ids") or []) or "all",
        min_pos  = lambda _: config.get("demux", {}).get("min_positions", 50),
        min_conc = lambda _: config.get("demux", {}).get("min_concordance", 0.4),
        min_gap  = lambda _: config.get("demux", {}).get("min_gap", 0.15),
    shell:
        """
        python scripts/match_vireo.py \
            --vireo-dir       {input.vireo} \
            --db              {params.db} \
            --run-ids         {params.run_ids} \
            --output          {output} \
            --min-positions   {params.min_pos} \
            --min-concordance {params.min_conc} \
            --min-gap         {params.min_gap} \
            2> {log}
        """


# ─────────────────────────────────────────────
# merge_demux — combine Vireo assignments,
# donor→DB matches, and binomial scorer output
# into a single final assignments table.
# In reference-guided mode (known_lines set),
# --guided is passed and --matches is omitted.
#
# Run explicitly:
#   snakemake results/demux/<demux_run_id>/final_assignments.tsv
# ─────────────────────────────────────────────
def _merge_inputs(wildcards):
    inputs = {
        "vireo":  f"results/demux/{wildcards.demux_run_id}/vireo",
        "scorer": f"results/demux/{wildcards.demux_run_id}/assignments.tsv",
    }
    if not _known_lines() and not _demux_cfg_opt("donor_vcf"):
        inputs["matches"] = f"results/demux/{wildcards.demux_run_id}/donor_matches.tsv"
    return inputs

rule merge_demux:
    input:
        unpack(_merge_inputs)
    output:
        "results/demux/{demux_run_id}/final_assignments.tsv"
    log:
        "logs/demux/{demux_run_id}/merge_demux.log"
    params:
        min_concordance = lambda _: config.get("demux", {}).get("min_concordance", 0.9),
        guided_flag     = lambda _: "--guided" if (_known_lines() or _demux_cfg_opt("donor_vcf")) else "",
        matches_flag    = lambda wildcards: (
            "" if (_known_lines() or _demux_cfg_opt("donor_vcf"))
            else f"--matches results/demux/{wildcards.demux_run_id}/donor_matches.tsv"
        )
    shell:
        """
        python scripts/merge_demux.py \
            --vireo-dir        {input.vireo} \
            {params.matches_flag} \
            --scorer           {input.scorer} \
            --output           {output} \
            --min-concordance  {params.min_concordance} \
            {params.guided_flag} \
            2> {log}
        """